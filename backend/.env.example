# Database Connection Strings (PostgreSQL instance details)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillgap_db"

# Secret Signature details for JWT encoding (keep highly confidential!)
JWT_SECRET="generate-some-high-entropy-confidential-string-here-2026"

# Gemini AI Platform API Key (Pull from Google AI Studio Platform panel)
GEMINI_API_KEY="YOUR_GOOGLE_AI_STUDIO_KEY"

# Port specification for FastAPI (Uvicorn binds here)
PORT=8000
